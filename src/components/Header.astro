---
import { Image } from 'astro:assets';
import { business } from '../data/business';
import { link } from '../lib/link';
import badge from '../assets/logo/dovey-badge.png';

const nav = [
  { href: link('/cakes/'), label: 'Cakes' },
  { href: link('/menu/'), label: 'Cookies & pops' },
  { href: link('/pop-ups/'), label: 'Pop-ups' },
  { href: link('/cake-ideas/'), label: 'Cake ideas' },
  { href: link('/about/'), label: 'About' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== link('/') && path.startsWith(href));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={link('/')} class="site-header__brand" aria-label={`${business.name} - home`}>
      <Image src={badge} alt="" width={44} height={44} densities={[1, 2]} loading="eager" class="site-header__badge" />
      <span class="site-header__name">{business.name}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a class="site-nav__tiktok" href={business.contact.tiktok.url} rel="me noopener" target="_blank" aria-label={`TikTok ${business.contact.tiktok.handle} (opens in a new tab)`}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" /></svg>
            TikTok
          </a>
        </li>
      </ul>
    </nav>

    <button type="button" class="site-header__search" data-open-search aria-label="Search the site">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
    <a class="btn btn--primary site-header__cta" href={link('/order/')}>Order</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--c-cream) 90%, white);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--c-line);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
    min-height: 66px;
    padding-block: var(--sp-2) 0;
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
    color: var(--c-ink);
    min-height: 44px;
  }
  .site-header__badge {
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }
  .site-header__name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1;
    white-space: nowrap;
  }

  /* Phone: brand left, search + Order right; the nav moves below as a scrollable row */
  .site-nav {
    order: 3;
    flex-basis: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin-inline: calc(var(--sp-5) * -1);
    padding-inline: var(--sp-5);
  }
  .site-nav::-webkit-scrollbar {
    display: none;
  }
  .site-nav__list {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--sp-2);
    display: flex;
    gap: var(--sp-3);
    white-space: nowrap;
  }
  .site-nav__list a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--c-ink-soft);
    text-decoration: none;
    padding: 0 2px;
    border-bottom: 2px solid transparent;
  }
  .site-nav__list a:hover {
    color: var(--c-ink);
  }
  .site-nav__list a[aria-current='page'] {
    color: var(--c-rose-deep);
    border-bottom-color: var(--c-rose-deep);
  }
  .site-nav__tiktok svg {
    width: 16px;
    height: 16px;
  }
  .site-nav__tiktok {
    color: var(--c-ink) !important;
  }
  .site-header__search {
    margin-left: auto;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--c-line);
    border-radius: 50%;
    background: var(--c-white);
    color: var(--c-ink);
    cursor: pointer;
    transition: border-color 0.16s ease, background-color 0.16s ease;
  }
  .site-header__search svg {
    width: 20px;
    height: 20px;
  }
  .site-header__search:hover {
    border-color: var(--c-ink);
    background: var(--c-cream);
  }
  .site-header__cta {
    padding: 0.7rem 1.35rem;
    min-height: 44px;
    font-size: var(--fs-sm);
  }

  @media (min-width: 880px) {
    .site-header__inner {
      flex-wrap: nowrap;
      gap: var(--sp-5);
      min-height: 76px;
      padding-block: var(--sp-2);
    }
    .site-header__name {
      font-size: 1.6rem;
    }
    .site-nav {
      order: 0;
      flex-basis: auto;
      margin-left: auto;
      margin-inline: auto 0;
      padding-inline: 0;
      overflow: visible;
    }
    .site-nav__list {
      gap: var(--sp-5);
      padding: 0;
    }
    .site-nav__list a {
      font-size: var(--fs-base);
      min-height: 44px;
    }
    .site-nav__tiktok svg {
      width: 18px;
      height: 18px;
    }
    .site-header__search {
      margin-left: 0;
    }
  }
</style>
