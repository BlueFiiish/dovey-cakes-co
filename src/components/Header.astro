---
import { Image } from 'astro:assets';
import { business } from '../data/business';
import { link } from '../lib/link';
import badge from '../assets/logo/dovey-badge.png';

const nav = [
  { href: link('/cakes/'), label: 'Cakes' },
  { href: link('/menu/'), label: 'Cookies & pops' },
  { href: link('/pop-ups/'), label: 'Pop-ups' },
  { href: link('/about/'), label: 'About' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== link('/') && path.startsWith(href));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={link('/')} class="site-header__brand" aria-label={`${business.name} - home`}>
      <Image src={badge} alt="" width={44} height={44} densities={[1, 2]} loading="eager" class="site-header__badge" />
      <span class="site-header__name">{business.name}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="btn btn--primary site-header__cta" href={link('/order/')}>Order</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--c-cream) 90%, white);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--c-line);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
    min-height: 66px;
    padding-block: var(--sp-2) 0;
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
    color: var(--c-ink);
    min-height: 44px;
  }
  .site-header__badge {
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }
  .site-header__name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1;
    white-space: nowrap;
  }

  /* Phone: brand left, Order right; the nav moves below as a scrollable row */
  .site-nav {
    order: 3;
    flex-basis: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin-inline: calc(var(--sp-5) * -1);
    padding-inline: var(--sp-5);
  }
  .site-nav::-webkit-scrollbar {
    display: none;
  }
  .site-nav__list {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--sp-2);
    display: flex;
    gap: var(--sp-3);
    white-space: nowrap;
  }
  .site-nav__list a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--c-ink-soft);
    text-decoration: none;
    padding: 0 2px;
    border-bottom: 2px solid transparent;
  }
  .site-nav__list a:hover {
    color: var(--c-ink);
  }
  .site-nav__list a[aria-current='page'] {
    color: var(--c-rose-deep);
    border-bottom-color: var(--c-rose-deep);
  }
  .site-header__cta {
    margin-left: auto;
    padding: 0.7rem 1.35rem;
    min-height: 44px;
    font-size: var(--fs-sm);
  }

  @media (min-width: 880px) {
    .site-header__inner {
      flex-wrap: nowrap;
      gap: var(--sp-6);
      min-height: 76px;
      padding-block: var(--sp-2);
    }
    .site-header__name {
      font-size: 1.6rem;
    }
    .site-nav {
      order: 0;
      flex-basis: auto;
      margin-left: auto;
      margin-inline: auto 0;
      padding-inline: 0;
      overflow: visible;
    }
    .site-nav__list {
      gap: var(--sp-6);
      padding: 0;
    }
    .site-nav__list a {
      font-size: var(--fs-base);
      min-height: 44px;
    }
    .site-header__cta {
      margin-left: 0;
    }
  }
</style>
