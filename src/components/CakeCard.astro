---
// The white-mat cake card: every cut-out cake is presented the same way.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CakeTag } from '../data/gallery';

interface Props {
  img: ImageMetadata;
  title: string;
  note?: string;
  tags?: readonly CakeTag[];
  eager?: boolean;
  priority?: boolean;
  /** Arch-topped mat (alternates in grids for the Dove & Laurel rhythm). */
  arch?: boolean;
}
const { img, title, note, tags = [], eager = false, priority = false, arch = false } = Astro.props;
const alt = note ? `${title} cake - ${note}` : `${title} cake by Dovey Cakes Co.`;
---

<figure class={`cake-card reveal${arch ? ' cake-card--arch' : ''}`} data-tags={tags.join(' ')}>
  <div class="cake-mat">
    <Image
      src={img}
      alt={alt}
      widths={[320, 480, 640, 800]}
      sizes="(min-width: 1000px) 300px, (min-width: 640px) 44vw, 88vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </div>
  <figcaption class="cake-card__cap">
    <span class="cake-card__title">{title}</span>
    {note && <span class="cake-card__note">{note}</span>}
  </figcaption>
</figure>

<style>
  .cake-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .cake-card .cake-mat {
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .cake-card--arch .cake-mat,
  .cake-card--arch .cake-mat img {
    border-radius: var(--radius-arch);
  }
  .cake-card--arch .cake-mat img {
    border-radius: 140px 140px var(--radius-sm) var(--radius-sm);
  }
  @media (hover: hover) {
    .cake-card:hover .cake-mat {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cake-card:hover .cake-mat {
      transform: none;
    }
  }
  .cake-card__cap {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-inline: var(--sp-1);
    min-height: 3.5rem;
  }
  .cake-card__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--c-ink);
    line-height: 1.15;
  }
  .cake-card__note {
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
  }
</style>
