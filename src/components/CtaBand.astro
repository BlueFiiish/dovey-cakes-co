---
import { business } from '../data/business';
import { link } from '../lib/link';
import LaurelDivider from './LaurelDivider.astro';

interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'Have something to celebrate?',
  body = `Send the date, the headcount and the idea. I'll reply with a quote and your pickup time. ${business.ordering.payments.join(' or ')} to lock it in, pickup in ${business.location.city}.`,
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-band__inner reveal">
    <LaurelDivider compact />
    <h2 class="cta-band__h">{heading}</h2>
    <p class="cta-band__p">{body}</p>
    <div class="cta-band__actions">
      <a class="btn btn--primary" href={link('/order/')}>Start an order</a>
      <a class="btn btn--secondary" href={business.contact.tiktok.url} rel="noopener" target="_blank">Watch on TikTok</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--c-butter);
  }
  .cta-band__inner {
    text-align: center;
    padding-block: var(--sp-7) var(--sp-9);
    max-width: 58ch;
  }
  .cta-band__h {
    margin-bottom: var(--sp-3);
  }
  .cta-band__p {
    color: var(--c-ink-soft);
    margin-inline: auto;
    margin-bottom: var(--sp-6);
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    justify-content: center;
  }
</style>
