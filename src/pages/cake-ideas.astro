---
// "Picture my cake": the customer describes a cake, Claude writes it up in the baker's voice
// and an image model renders one concept. Needs the Cloudflare host + API keys (SETUP.md);
// until then the page shows a gentle "not switched on yet" and points to the order form.
import BaseLayout from '../layouts/BaseLayout.astro';
import LaurelDivider from '../components/LaurelDivider.astro';
import { link } from '../lib/link';

const title = 'Picture your cake';
const description =
  'Describe the cake you have in mind and get a concept image and a write-up from Dovey Cakes Co. in Rosenberg, TX. Then send it straight to the order form.';
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const occasions = ['Birthday', 'First birthday', 'Baby shower', 'Baptism', 'Wedding', 'Anniversary', 'Graduation', 'Just because'];
---

<BaseLayout title={title} description={description}>
  <section class="section ideas-intro">
    <div class="container">
      <p class="eyebrow">Picture your cake</p>
      <h1>Not sure what you want yet?</h1>
      <p class="lead">
        Describe it however you can: the colors, the theme, who it&rsquo;s for. You&rsquo;ll get a
        concept picture and a write-up you can send straight to the order form. It&rsquo;s a starting
        point, not a quote: the real cake is piped by hand.
      </p>
    </div>
  </section>

  <section class="section section--white ideas-main">
    <div class="container ideas-layout">
      <form class="idea-form" id="idea-form" data-endpoint={link('/api/cake-idea')}>
        <div class="field">
          <label for="idea-occasion">Occasion</label>
          <select id="idea-occasion" name="occasion">
            <option value="">Choose one…</option>
            {occasions.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="idea-desc">What are you dreaming up? <span class="req" aria-hidden="true">*</span></label>
          <textarea id="idea-desc" name="description" rows="5" required minlength="8" maxlength="600" placeholder="e.g. a sage green vintage heart cake with white piping, 'Happy 30th Ana' on top, pearls, for about 15 people"></textarea>
          <p class="field__help">Mention a name or age if you want it piped on.</p>
        </div>
        {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="light"></div>}
        <button type="submit" class="btn btn--primary" id="idea-submit">Picture it</button>
        <p class="form-error" id="idea-error" hidden role="alert"></p>
      </form>

      <div class="idea-result" id="idea-result" hidden aria-live="polite">
        <div class="idea-result__media" id="idea-media">
          <img id="idea-img" alt="" hidden />
          <p class="idea-result__noimg" id="idea-noimg" hidden>No picture this time, but here&rsquo;s the idea in words.</p>
        </div>
        <div class="idea-result__text">
          <p class="eyebrow">Here&rsquo;s what I see</p>
          <p class="idea-result__reply" id="idea-reply"></p>
          <p class="idea-result__flavor" id="idea-flavor"></p>
          <div class="idea-result__actions">
            <a class="btn btn--primary" id="idea-order" href={link('/order/')}>Send this to the order form</a>
            <a class="btn btn--secondary" id="idea-download" download="dovey-cake-idea.webp" hidden>Save the picture</a>
            <button type="button" class="btn btn--secondary" id="idea-again">Try another</button>
          </div>
          <p class="idea-result__fine">Concept image generated by AI from your description. The finished cake will be made by hand and may differ.</p>
        </div>
      </div>

      <div class="idea-off" id="idea-off" hidden>
        <p class="idea-off__h">This isn&rsquo;t switched on just yet.</p>
        <p>Send your idea through the <a href={link('/order/')}>order form</a> instead and I&rsquo;ll sketch it out with you by email.</p>
      </div>
    </div>
  </section>

  <LaurelDivider />
</BaseLayout>

{turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const form = document.getElementById('idea-form') as HTMLFormElement | null;
  const submit = document.getElementById('idea-submit') as HTMLButtonElement | null;
  const errorEl = document.getElementById('idea-error');
  const result = document.getElementById('idea-result');
  const img = document.getElementById('idea-img') as HTMLImageElement | null;
  const noimg = document.getElementById('idea-noimg');
  const reply = document.getElementById('idea-reply');
  const flavor = document.getElementById('idea-flavor');
  const order = document.getElementById('idea-order') as HTMLAnchorElement | null;
  const download = document.getElementById('idea-download') as HTMLAnchorElement | null;
  const again = document.getElementById('idea-again');
  const off = document.getElementById('idea-off');

  if (form && submit && errorEl && result && img && noimg && reply && flavor && order && download && again && off) {
    const endpoint = form.dataset.endpoint || '/api/cake-idea';
    const orderBase = order.getAttribute('href') || '/order/';

    const showError = (msg: string) => {
      errorEl.textContent = msg;
      errorEl.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      const fd = new FormData(form);
      const description = String(fd.get('description') || '').trim();
      const occasion = String(fd.get('occasion') || '');
      const turnstileToken = String(fd.get('cf-turnstile-response') || '');
      submit.disabled = true;
      submit.textContent = 'Picturing…';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ description, occasion, turnstileToken }),
        });
        if (res.status === 404 || res.status === 503) {
          form.hidden = true;
          off.hidden = false;
          return;
        }
        const data = (await res.json().catch(() => ({}))) as {
          reply?: string; suggestedFlavor?: string; orderNote?: string; image?: string | null; error?: string;
        };
        if (!res.ok || !data.reply) {
          showError(
            res.status === 429
              ? 'A lot of people are picturing cakes right now. Try again in a minute.'
              : 'That didn’t work. Try a shorter description, or send it through the order form.'
          );
          return;
        }
        reply.textContent = data.reply;
        flavor.textContent = data.suggestedFlavor ? `Flavor idea: ${data.suggestedFlavor}` : '';
        if (data.image) {
          img.src = data.image;
          img.alt = `Concept image: ${data.orderNote || description}`;
          img.hidden = false;
          noimg.hidden = true;
          download.href = data.image;
          download.hidden = false;
        } else {
          img.hidden = true;
          noimg.hidden = false;
          download.hidden = true;
        }
        const note = data.orderNote || description;
        order.href = `${orderBase}?idea=${encodeURIComponent(note)}${occasion ? `&occasion=${encodeURIComponent(occasion)}` : ''}`;
        form.hidden = true;
        result.hidden = false;
        result.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch {
        showError('That didn’t work. Check your connection and try again.');
      } finally {
        submit.disabled = false;
        submit.textContent = 'Picture it';
      }
    });

    again.addEventListener('click', () => {
      result.hidden = true;
      form.hidden = false;
      (document.getElementById('idea-desc') as HTMLTextAreaElement | null)?.focus();
    });
  }
</script>

<style>
  .ideas-intro h1 {
    margin-bottom: var(--sp-3);
    max-width: 16ch;
    text-wrap: balance;
  }
  .ideas-intro {
    padding-bottom: var(--sp-5);
  }
  .ideas-main {
    padding-top: var(--sp-6);
  }
  .ideas-layout > * {
    max-width: 760px;
  }
  .idea-form {
    display: grid;
    gap: var(--sp-4);
  }
  .field label {
    display: block;
    font-weight: 700;
    font-size: var(--fs-sm);
    margin-bottom: var(--sp-1);
  }
  .req {
    color: var(--c-rose-deep);
  }
  .field select,
  .field textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--c-ink);
    background: var(--c-white);
    border: 1.5px solid var(--c-border-field);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem;
    min-height: 48px;
  }
  .field textarea {
    resize: vertical;
  }
  .field textarea::placeholder {
    color: var(--c-placeholder);
  }
  .field__help {
    font-size: var(--fs-xs);
    color: var(--c-ink-soft);
    margin: var(--sp-1) 0 0;
  }
  .form-error {
    margin: 0;
    padding: var(--sp-3) var(--sp-4);
    background: #fde8e8;
    border: 1px solid #e3a0a0;
    border-radius: var(--radius-sm);
    color: #7a1f1f;
    font-size: var(--fs-sm);
  }
  .idea-result {
    display: grid;
    gap: var(--sp-5);
  }
  @media (min-width: 720px) {
    .idea-result {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-6);
      align-items: start;
    }
  }
  .idea-result__media {
    background: var(--c-mat);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-arch);
    overflow: hidden;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-card);
  }
  .idea-result__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .idea-result__noimg {
    margin: 0;
    padding: var(--sp-5);
    text-align: center;
    color: var(--c-ink-soft);
  }
  .idea-result__reply {
    font-size: var(--fs-md);
  }
  .idea-result__flavor {
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
  }
  .idea-result__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-4);
  }
  .idea-result__fine {
    margin: var(--sp-4) 0 0;
    font-size: var(--fs-xs);
    color: var(--c-ink-soft);
  }
  .idea-off {
    padding: var(--sp-5);
    background: var(--c-blush);
    border-radius: var(--radius);
  }
  .idea-off__h {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-bottom: var(--sp-2);
  }
  .idea-off p:last-child {
    margin: 0;
  }
</style>
