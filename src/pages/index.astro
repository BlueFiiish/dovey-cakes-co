---
// Home: the cakes come first. A short headline, then a shelf of five cakes (visible before
// any copy on a phone), then a fourteen-cake showcase with two double-size tiles. Pop-ups,
// cookies and the how-it-works copy sit below the cakes; the full steps live on /order/.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LaurelDivider from '../components/LaurelDivider.astro';
import CakeTile from '../components/CakeTile.astro';
import CtaBand from '../components/CtaBand.astro';
import PopupStrip from '../components/PopupStrip.astro';
import { business } from '../data/business';
import { gallery, type GalleryItem } from '../data/gallery';
import { imageForSlug } from '../lib/galleryImages';
import { link } from '../lib/link';

const pick = (slugs: string[]): GalleryItem[] =>
  slugs.map((s) => gallery.find((g) => g.slug === s)).filter((g): g is GalleryItem => Boolean(g));

// The shelf under the headline. Five cakes, no overlap with the showcase below.
const shelf = pick(['thirty-flirty-heart', 'coco-luna', 'leopard-heart', 'harry-potter', 'just-married-heart']);

// The showcase grid: 12 singles + 2 features = 20 cells, five clean rows of four.
const featureSlugs = new Set(['cow-print-first-birthday', 'sweet-sixteen-brianna']);
const showcase = pick([
  'cow-print-first-birthday',
  'sagittarius-queen',
  'fairy-garden',
  'hello-kitty-avery',
  'cinnamoroll',
  'unicorn-mila',
  'winnie-the-pooh-oh-baby',
  'sweet-sixteen-brianna',
  'ivory-rosettes-and-pearls',
  'stitch',
  'peach-heart-21',
  'orange-roses-and-daisies',
  'first-rodeo-sahir',
  'piplup',
]);
---

<BaseLayout>
  <!-- HERO: headline + a shelf of cakes --------------------------------- -->
  <section class="hero">
    <div class="container hero__copy">
      <p class="eyebrow">Custom cakes &middot; cookies &middot; cake pops &middot; {business.location.city}</p>
      <h1 class="hero__title">Sweet things, <em>softly</em> made.</h1>
      <p class="lead hero__lead">
        Hand-piped, made-to-order cakes from a small home kitchen in Rosenberg. Every cake on
        this page was somebody&rsquo;s idea.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={link('/order/')}>Start an order</a>
        <a class="btn btn--secondary" href={link('/cakes/')}>See all {gallery.length} cakes</a>
      </div>
    </div>

    <ul class="shelf" role="list" aria-label="Recent cakes">
      {shelf.map((c, i) => (
        <li class="shelf__item">
          <a class="shelf__card" href={link(`/cakes/#${c.slug}`)}>
            <Image
              src={imageForSlug(c.slug)}
              alt={c.note ? `${c.title} cake - ${c.note}` : `${c.title} cake`}
              widths={[320, 480, 640]}
              sizes="(min-width: 880px) 270px, 62vw"
              loading={i < 3 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />
            <span class="shelf__cap">{c.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- TRUST STRIP -------------------------------------------------------- -->
  <div class="trust">
    <ul class="container trust__list" role="list">
      <li>Made to order</li>
      <li>Pickup in {business.location.city.replace(', TX', '')}</li>
      <li>{business.ordering.payments.join(' or ')}</li>
      <li>Order {business.ordering.leadTimeDays} days ahead</li>
    </ul>
  </div>

  <!-- SHOWCASE ----------------------------------------------------------- -->
  <section class="section showcase-sec">
    <div class="container">
      <header class="sec-head sec-head--row reveal">
        <div>
          <p class="eyebrow">Recent orders</p>
          <h2>Made for someone in Rosenberg</h2>
        </div>
        <a class="btn btn--secondary showcase-sec__all" href={link('/cakes/')}>All {gallery.length} cakes</a>
      </header>

      <ul class="showcase" role="list">
        {showcase.map((c, i) => {
          const feature = featureSlugs.has(c.slug);
          return (
            <li class:list={['showcase__item', { 'showcase__item--feature': feature }]}>
              <CakeTile
                img={imageForSlug(c.slug)}
                title={c.title}
                note={c.note}
                slug={c.slug}
                href={link(`/cakes/#${c.slug}`)}
                feature={feature}
                arch={!feature && i % 3 === 2}
                eager={i < 3}
              />
            </li>
          );
        })}
      </ul>

      <p class="sec-cta reveal">
        <a class="btn btn--primary" href={link('/order/')}>Start an order</a>
        <a class="btn btn--secondary" href={link('/cakes/')}>See all {gallery.length} cakes</a>
      </p>
    </div>
  </section>

  <LaurelDivider />

  <!-- POP-UPS, COOKIES & CAKE POPS --------------------------------------- -->
  <PopupStrip />

  <CtaBand />
</BaseLayout>

<style>
  /* ---- Hero ------------------------------------------------------------ */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--c-cream);
    padding-top: var(--sp-7);
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: var(--sp-5);
  }
  .hero__title {
    max-width: 14ch;
    text-wrap: balance;
    margin-bottom: var(--sp-3);
  }
  .hero__lead {
    max-width: 46ch;
    margin-inline: auto;
    margin-bottom: var(--sp-5);
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
  }

  /* The shelf: a scroll-snap strip on phones, a staggered row of five on desktop. */
  .shelf {
    list-style: none;
    margin: 0;
    padding: var(--sp-2) var(--sp-5) var(--sp-6);
    display: flex;
    gap: var(--sp-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--sp-5);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .shelf::-webkit-scrollbar {
    display: none;
  }
  .shelf__item {
    flex: 0 0 62vw;
    max-width: 300px;
    scroll-snap-align: start;
  }
  .shelf__card {
    position: relative;
    display: block;
    background: var(--c-mat);
    border: 1px solid var(--c-line);
    border-radius: 999px 999px var(--radius) var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    text-decoration: none;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .shelf__card img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .shelf__cap {
    position: absolute;
    left: 50%;
    bottom: var(--sp-3);
    transform: translateX(-50%);
    max-width: calc(100% - var(--sp-5));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.2;
    color: var(--c-ink);
    background: color-mix(in srgb, var(--c-white) 90%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-pill);
    padding: 5px 14px;
  }
  @media (min-width: 880px) {
    .hero {
      padding-top: var(--sp-8);
    }
    .hero__copy {
      margin-bottom: var(--sp-6);
    }
    .shelf {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: var(--sp-5);
      overflow: visible;
      width: 100%;
      max-width: 1480px;
      margin-inline: auto;
      padding: var(--sp-3) var(--sp-6) var(--sp-8);
      align-items: start;
    }
    .shelf__item {
      max-width: none;
    }
    .shelf__item:nth-child(even) {
      padding-top: var(--sp-7);
    }
    @media (hover: hover) {
      .shelf__card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lift);
      }
    }
  }

  /* ---- Trust strip ----------------------------------------------------- */
  .trust {
    background: var(--c-blush);
    padding-block: var(--sp-3);
  }
  .trust__list {
    list-style: none;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-2) var(--sp-6);
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .trust__list li {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .trust__list li::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-rose);
  }

  /* ---- Showcase -------------------------------------------------------- */
  .showcase-sec {
    padding-top: var(--sp-7);
  }
  .sec-head--row {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--sp-4);
  }
  .sec-head--row h2 {
    margin-bottom: 0;
  }
  .showcase-sec__all {
    display: none;
  }
  @media (min-width: 720px) {
    .showcase-sec__all {
      display: inline-flex;
    }
  }
  .showcase {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-flow: dense;
    gap: var(--sp-3);
  }
  .showcase__item--feature {
    grid-column: span 2;
    grid-row: span 2;
  }
  @media (min-width: 720px) {
    .showcase {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-4);
    }
  }
  @media (min-width: 1000px) {
    .showcase {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--sp-5);
    }
  }
  .sec-cta {
    margin: var(--sp-7) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    justify-content: center;
  }
</style>
