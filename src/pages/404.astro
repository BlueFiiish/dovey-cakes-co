---
import BaseLayout from '../layouts/BaseLayout.astro';
import LaurelDivider from '../components/LaurelDivider.astro';
import { link } from '../lib/link';
---

<BaseLayout title="Page not found" description="That page has crumbled. Find your way back to Dovey Cakes Co.">
  <section class="section nf">
    <div class="container nf__inner">
      <p class="eyebrow">Error 404</p>
      <h1 class="nf__title">This slice is missing.</h1>
      <p class="lead">The page you were looking for has crumbled away. Let&rsquo;s get you back to the good stuff.</p>
      <div class="nf__actions">
        <a class="btn btn--primary" href={link('/')}>Back to home</a>
        <a class="btn btn--secondary" href={link('/cakes/')}>See the cakes</a>
      </div>
      <p class="nf__links">
        Or jump to the <a href={link('/menu/')}>menu</a> or <a href={link('/order/')}>start an order</a>.
      </p>
    </div>
  </section>
  <LaurelDivider />
</BaseLayout>

<style>
  .nf {
    text-align: center;
  }
  .nf__inner {
    max-width: 52ch;
  }
  .nf__title {
    margin-bottom: var(--sp-4);
  }
  .nf .lead {
    margin-inline: auto;
    margin-bottom: var(--sp-6);
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    justify-content: center;
    margin-bottom: var(--sp-5);
  }
  .nf__links {
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
  }
</style>
